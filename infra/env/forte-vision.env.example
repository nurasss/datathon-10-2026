# =====================================================================================
# ForteVision — единственный файл с секретами и настройками рантайма.
#
# Куда положить:   ~/.config/forte-vision/forte-vision.env
# Права:           chmod 600   (файл содержит ключи, в git его никогда не коммитить)
#
# Формат: обычный shell-совместимый `KEY=value`, без пробелов вокруг `=`,
# без кавычек для простых значений. Комментарии начинаются с `#`.
# Файл читается скриптами инфраструктуры через `set -a; . FILE; set +a`.
#
# install.sh копирует этот файл в ~/.config/forte-vision/forte-vision.env,
# если его ещё нет, и генерирует FV_SECRET автоматически.
# =====================================================================================

# -------------------------------------------------------------------------------------
# 1. Пути
# -------------------------------------------------------------------------------------
# Где лежит рабочий код сервиса (скрипты, apps/, packages/, .venv).
# Именно отсюда запускается бэкенд. fv-infra — только инфраструктура и документация.
FV_APP_ROOT=/Users/nuras/Desktop/datathon/forte-vision

# Где лежит этот инфраструктурный worktree (install.sh подставит сам).
FV_INFRA_ROOT=/Users/nuras/Desktop/datathon/fv-infra

# Интерпретатор. Пусто = $FV_APP_ROOT/.venv/bin/python (задаётся в scripts/run_server.sh).
# FV_PYTHON=/Users/nuras/Desktop/datathon/forte-vision/.venv/bin/python

# Где хранить jobs.db, uploads/, evidence/. По умолчанию $FV_APP_ROOT/data.
# FV_DATA_DIR=/Users/nuras/Desktop/datathon/forte-vision/data

# -------------------------------------------------------------------------------------
# 2. Секреты  (НЕ коммитить, НЕ показывать на скриншотах)
# -------------------------------------------------------------------------------------
# Ключ(и) для жюри. Обязателен. Несколько ключей — через запятую.
# Сгеренировать:  openssl rand -hex 24
FV_API_KEYS=ЗАМЕНИ-НА-СЛУЧАЙНЫЙ-КЛЮЧ-ЖЮРИ

# Отдельный ключ для веб-UI (браузерная сессия на подписанной cookie).
# Пусто = UI доступен без пароля всем, кто дошёл до адреса. Для публичного URL не оставлять пустым.
FV_UI_KEY=

# Секрет для подписи cookie UI. Если пусто — генерируется случайно при каждом старте,
# то есть пользователи UI разлогиниваются после каждого перезапуска. install.sh заполнит.
FV_SECRET=

# -------------------------------------------------------------------------------------
# 3. Рантайм бэкенда
# -------------------------------------------------------------------------------------
# Параллельных задач обработки. 2 = как в задании; на 2-ядерном/8 ГБ Mac это предел,
# при OOM/SWAP поставь 1 (обработка последовательная, но стабильнее).
FV_WORKER_CONCURRENCY=2

# Жёсткий бюджет на задачу в секундах, считается от момента приёма файла (включая очередь).
# Контракт/жюри: 5 минут на видео. Значение выше 280 не имеет смысла: config.py режет до 280.
FV_JOB_TIMEOUT_SEC=280

# Лимиты приёма.
FV_MAX_UPLOAD_MB=100
FV_MAX_QUEUE=8
FV_RETENTION_HOURS=72

# Слушать. 0.0.0.0 = доступен с LAN (прокси Next.js на этом же Mac достучится всегда).
# 127.0.0.1 = только локально, строже, но прокси должен ходить на 127.0.0.1 (не на localhost).
FV_HOST=0.0.0.0

# Порт бэкенда. scripts/run_server.sh сейчас жёстко использует 8000 (порт не читается из env).
# Порт 8000 и есть контракт с прокси. Менять только вместе с прокси.
FV_BACKEND_PORT=8000

# Публичный адрес сервиса: подставляется в примеры curl на странице UI.
# Должен совпадать с адресом туннеля, иначе UI будет показывать неправильные примеры.
# FV_PUBLIC_BASE_URL=https://team.ngrok-free.app

# -------------------------------------------------------------------------------------
# 4. Туннель
# -------------------------------------------------------------------------------------
# Провайдер: ngrok | cloudflared-named | cloudflared-quick
#   ngrok             — основной вариант: бесплатный статический домен, адрес не меняется.
#   cloudflared-named — если у команды есть домен в Cloudflare (адрес тоже постоянный).
#   cloudflared-quick — только для отладки: случайный *.trycloudflare.com на каждый запуск.
FV_TUNNEL_PROVIDER=ngrok

# Куда туннель отправляет трафик.
#   http://127.0.0.1:3000 — Next.js на этом же Mac (проксирует /api/v1/* на бэкенд).
#   http://127.0.0.1:8000 — напрямую в FastAPI, если Next.js не поднят или прокси не работает.
# ПРОВЕРКА ПЕРЕД СДАЧЕЙ: адрес жюри должен приводить и к /api/v1/*, и (по возможности) к UI.
FV_TUNNEL_UPSTREAM=http://127.0.0.1:3000

# --- ngrok (FV_TUNNEL_PROVIDER=ngrok) ---
# authtoken из личного кабинета ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Бесплатный статический домен из кабинета: https://dashboard.ngrok.com/domains
# Без схемы, только хост. Адрес не меняется между перезапусками агента.
NGROK_DOMAIN=
# Локальный API ngrok (:4040) — healthcheck.sh берёт из него публичный URL автоматически.
# Порт менять только если 4040 занят.
NGROK_WEB_ADDR=127.0.0.1:4040

# --- cloudflared (FV_TUNNEL_PROVIDER=cloudflared-*) ---
# Имя named-туннеля, созданного человеком: cloudflared tunnel create <имя>
CLOUDFLARED_TUNNEL=
# Конфиг с ingress-правилами (по умолчанию ~/.cloudflared/config.yml)
CLOUDFLARED_CONFIG=
# Публичный адрес для named-туннеля, например https://vision.example.com
CLOUDFLARED_PUBLIC_URL=

# -------------------------------------------------------------------------------------
# 5. Healthcheck
# -------------------------------------------------------------------------------------
# Короткое реальное видео для проверки. Проверяем на одном файле, чтобы не грузить CPU.
FV_HEALTHCHECK_FILE=/Users/nuras/Desktop/datathon/data_raw/open/videos/Х-20.mov
# Сколько секунд ждать статус done (лимит жюри — 300 с).
FV_HEALTHCHECK_TIMEOUT=300
# Публичный адрес для проверки "снаружи". Пусто = взять из NGROK_DOMAIN/CLOUDFLARED_PUBLIC_URL
# или спросить локальный API ngrok. FV_PUBLIC_BASE_URL выше используется для того же.
